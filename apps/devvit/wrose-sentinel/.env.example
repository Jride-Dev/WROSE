# WROSE Sentinel Devvit Configuration
# Copy this file to .env and adjust values.

WROSE_API_BASE_URL=http://127.0.0.1:8000

# Tunnel Notes
# -----
# 127.0.0.1:8000 works for local browser testing but will NOT work
# from the Devvit runtime (Reddit's servers cannot reach your localhost).
#
# For playtest, use a temporary HTTPS tunnel:
#   ngrok:    https://random-id.ngrok.io
#   Cloudflare: https://random-name.trycloudflare.com
#
# See docs/TUNNEL_PLAYTEST_SETUP.md for setup instructions.
# Do not leave tunnels running after testing.
